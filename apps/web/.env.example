# ── Database ────────────────────────────────────────────────
# "mongo" or "file". If omitted: mongo when MONGODB_URI is set, otherwise file.
# The file driver stores everything in apps/web/data/ (great for local dev).
DB_DRIVER=
MONGODB_URI=
MONGODB_DB=otrelink

# ── Auth ────────────────────────────────────────────────────
# Long random string. Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# ── URLs ────────────────────────────────────────────────────
# Where the public link page app (apps/page) is served. Used for "View page" links.
NEXT_PUBLIC_PAGE_URL=http://localhost:5173
# Origins allowed to call the public API (comma separated, * for any).
PUBLIC_CORS_ORIGINS=*

# ── Bookings: notifications & reminders ─────────────────────
# Push notifications. Generate the pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret for the reminders cron (cron-job.org → https://YOUR-APP/api/cron/reminders,
# header  Authorization: Bearer <CRON_SECRET>). Any long random string.
CRON_SECRET=
# Optional: emails to visitors (confirmation + reminders) with https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Your Name <bookings@yourdomain.com>"
